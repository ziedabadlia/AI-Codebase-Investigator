# ==============================================================================
# AI Codebase Investigator - Environment Configuration Template
# Codebase location: apps/api and apps/web
# ==============================================================================

# Backend (apps/api) Configurations
# ------------------------------------------------------------------------------
# PostgreSQL database connection URI string. Must include pgvector extension capability.
# For local Docker: postgresql://postgres:password@localhost:5432/codebase_investigator
# For Supabase: postgresql://postgres.[project-id]:[password]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql://postgres:password@localhost:5432/codebase_investigator

# Gemini API Key (Required for reasoning & agents)
# Get from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# GitHub Personal Access Token (Recommended to prevent API rate limits)
# Get from: https://github.com/settings/tokens
GITHUB_TOKEN=your_github_token_here

# FastAPI Execution Environment
ENVIRONMENT=development
PORT=8000

# Frontend (apps/web) Configurations
# ------------------------------------------------------------------------------
# URL of the backend API for client-side fetches and Server-Sent Events (SSE)
NEXT_PUBLIC_API_URL=http://localhost:8000
